{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luana-helena-lp",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    // Saída do `npm run build` (Vite)
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Só /api/* passa pelo Worker; o resto é servido direto como arquivo estático
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
